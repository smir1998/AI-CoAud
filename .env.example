# ── AI CoAudS web console ────────────────────────────────
# Build-time settings (VITE_* are inlined into the bundle).
# Runtime secrets (GitHub / Anthropic / OpenAI keys) are NEVER baked in —
# they are entered in the console UI and kept in localStorage only.

# Override API endpoints (proxies, GitHub Enterprise, gateways)
VITE_GITHUB_API=https://api.github.com
VITE_ANTHROPIC_API=https://api.anthropic.com
VITE_OPENAI_API=https://api.openai.com

# Default models offered in the settings drawer
VITE_ANTHROPIC_MODEL=claude-sonnet-4-5
VITE_OPENAI_MODEL=gpt-4.1-mini

# Set to "false" to ship a deterministic-only build (no LLM UI)
VITE_LLM_ENABLED=true

# ── GitHub Pages deploy (set automatically by deploy.yml) ─
# VITE_BASE=/ai-coauds/             # subpath base — Pages serves from /<repo>/
# VITE_REPO_URL=                    # repo link behind the footer "live" chip
# VITE_DEPLOYED_URL=                # https://<user>.github.io/<repo>/
