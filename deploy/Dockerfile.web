# ── AI CoAudS console (static SPA) ───────────────────────
# stage 1 — build with exact lockfile
FROM node:24-alpine AS build
WORKDIR /src
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build

# stage 2 — serve hardened nginx
FROM nginx:stable-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

# content-hash fingerprint for zero-downtime deploys
RUN printf '{"service":"ai-coauds-web","image_build":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    > /usr/share/nginx/html/health.json

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -qO- http://localhost/health.json || exit 1
