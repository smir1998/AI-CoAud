# ── GitHub ───────────────────────────────────────────────
# Fine-grained PAT or GitHub App token: pull_request read + write
GITHUB_TOKEN=github_pat_xxx
# Webhook payload secret (must match the webhook config in GitHub)
GITHUB_WEBHOOK_SECRET=change-me-to-32-random-bytes
# Comma-separated owner/repo allowlist; empty = allow everything
ALLOWED_REPOS=acme/web-shop,acme/payments-api

# ── LLM ──────────────────────────────────────────────────
# CrewAI routes through LiteLLM — any provider string works
LLM_MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional fallback provider for the direct-API path
OPENAI_API_KEY=

# ── infrastructure ───────────────────────────────────────
# Leave unset to run stateless in-memory (single instance, dev only)
REDIS_URL=redis://redis:6379/0

# ── throughput guards ────────────────────────────────────
WORKERS=2
MAX_QUEUE=20
